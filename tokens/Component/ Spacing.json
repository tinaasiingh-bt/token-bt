{
  "help-text": {
    "default": {
      "content": {
        "margin": {
          "negative": {
            "$type": "spacing",
            "$value": "{spacing.negative.8xs}"
          }
        },
        "padding": {
          "none": {
            "$type": "spacing",
            "$value": "{spacing.none}"
          }
        }
      }
    }
  },
  "menu": {
    "default": {
      "menu-popup": {
        "margin": {
          "$type": "spacing",
          "$value": "{spacing.3xs}"
        }
      }
    }
  },
  "radio-button": {
    "default": {
      "instructional": {
        "margin": {
          "$type": "spacing",
          "$value": "{spacing.negative.4xs}"
        }
      }
    }
  },
  "slider": {
    "horizontal": {
      "margin": {
        "$type": "spacing",
        "$value": "{spacing.2xl}"
      }
    }
  },
  "tab": {
